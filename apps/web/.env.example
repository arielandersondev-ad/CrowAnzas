# mock: usuarios y gastos guardados solo en este navegador; v2 empieza vacío.
# api: conexión real con Nest, sin fallback automático a mock.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_TIMEZONE=America/La_Paz
# Solo cambia la etiqueta visual; todos los gastos usan la misma moneda.
NEXT_PUBLIC_CURRENCY=Bs
